# Copy to .env and adjust. Never commit .env.
# Values below match docker-compose.yml (local development only).

# Public base URL, used for canonical links and the CSRF origin check.
SITE_URL=http://localhost:3000

# Runtime connection: the least-privilege role (rows only, no schema changes).
DATABASE_URL=postgres://site_app:site_app_dev@127.0.0.1:5433/personal_site
# Migrations only: the schema-owner role.
MIGRATION_DATABASE_URL=postgres://site_owner:site_owner_dev@127.0.0.1:5433/personal_site

# Integration tests use a separate database.
TEST_DATABASE_URL=postgres://site_app:site_app_dev@127.0.0.1:5433/personal_site_test
TEST_MIGRATION_DATABASE_URL=postgres://site_owner:site_owner_dev@127.0.0.1:5433/personal_site_test

# Server-side secret, at least 32 random characters. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
APP_SECRET=

# Uploaded files (public/ and private/ subfolders are created inside).
STORAGE_DIR=./storage

# Reverse proxies in front of the app that set X-Forwarded-For (1 behind Caddy, 0 locally).
TRUST_PROXY_HOPS=0

# End-to-end tests use their own database (it is wiped at the start of each run).
E2E_DATABASE_URL=postgres://site_app:site_app_dev@127.0.0.1:5433/personal_site_e2e
E2E_MIGRATION_DATABASE_URL=postgres://site_owner:site_owner_dev@127.0.0.1:5433/personal_site_e2e

LOG_LEVEL=info
DATABASE_POOL_MAX=10


# --- Optional -------------------------------------------------------------
# Object storage for uploads instead of STORAGE_DIR (docs/DEPLOYMENT.md §7).
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Hosts with a small request-body limit (Vercel: 4.5 MB): the browser uploads
# straight to the bucket with a signed URL (docs/DEPLOYMENT_VERCEL.md).
# UPLOAD_MODE=direct
# Serverless: a small pool per instance; "false" only if a pooler rejects prepared statements.
# DATABASE_POOL_MAX=3
# DATABASE_PREPARE=true
# Vercel Cron bearer token for /api/cron/maintenance (unset = route disabled).
# CRON_SECRET=

# Download the newest encrypted backup with `npm run backup:fetch` (read-only keys).
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Email notification for each new contact message (docs/DEPLOYMENT.md §9).
# Leave SMTP_URL empty to keep notifications off; messages are always stored.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=Website <site@example.com>
# CONTACT_NOTIFY_TO=you@example.com
