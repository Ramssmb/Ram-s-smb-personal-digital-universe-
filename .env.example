# Copy to .env and adjust. Never commit .env.
# Values below match docker-compose.yml (local development only).

# Public base URL, used for canonical links and the CSRF origin check.
SITE_URL=http://localhost:3000

# Runtime connection: the least-privilege role (rows only, no schema changes).
DATABASE_URL=postgres://site_app:site_app_dev@127.0.0.1:5433/personal_site
# Migrations only: the schema-owner role.
MIGRATION_DATABASE_URL=postgres://site_owner:site_owner_dev@127.0.0.1:5433/personal_site

# Integration tests use a separate database.
TEST_DATABASE_URL=postgres://site_app:site_app_dev@127.0.0.1:5433/personal_site_test
TEST_MIGRATION_DATABASE_URL=postgres://site_owner:site_owner_dev@127.0.0.1:5433/personal_site_test

LOG_LEVEL=info
DATABASE_POOL_MAX=10

# 1 = serve the component gallery at /admin/design (development aid). Keep 0 in production.
DESIGN_GALLERY=0
