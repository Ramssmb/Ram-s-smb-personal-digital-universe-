# Production configuration for docker-compose.prod.yml.
# Copy to .env.production on the server (chmod 600). Never commit the real file.
# Generate every secret with:  openssl rand -hex 32
# Use hex: base64 output can contain "/", "+" and "=", which break the database URLs.

# Your domain, with DNS A/AAAA records pointing at the server.
DOMAIN=example.com

POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# At least 32 random characters.
APP_SECRET=

LOG_LEVEL=info

# --- Optional: object storage for uploads (docs/DEPLOYMENT.md §7) ----------
# Without these, uploads live in the `media` Docker volume (backed up by backup.sh).
STORAGE_DRIVER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Optional: email for new contact messages (docs/DEPLOYMENT.md §9) -------
# Empty SMTP_URL = notifications off. Put credentials only here, never in the repo.
SMTP_URL=
SMTP_FROM=
CONTACT_NOTIFY_TO=
