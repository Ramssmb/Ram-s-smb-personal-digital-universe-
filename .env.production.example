# Production configuration for docker-compose.prod.yml.
# Copy to .env.production on the server (chmod 600). Never commit the real file.
# Generate every secret with:  openssl rand -base64 32

# Your domain, with DNS A/AAAA records pointing at the server.
DOMAIN=example.com
# Optional: Let's Encrypt expiry notices.
ACME_EMAIL=

POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# At least 32 random characters.
APP_SECRET=

LOG_LEVEL=info
