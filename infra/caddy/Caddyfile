{
	# Used by Let's Encrypt for expiry notices. Optional.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Uploads are capped at 15 MB by the app; leave a little room for multipart overhead.
	request_body {
		max_size 16MB
	}

	reverse_proxy app:3000 {
		# Replace (not append) the client address so it cannot be forged upstream.
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output stdout
		format json
	}
}

# Redirect the www. variant to the canonical domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
