{
  "name": "personal-digital-universe",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env --conditions=react-server scripts/admin.ts",
    "db:seed": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed.ts",
    "maintenance": "tsx --env-file-if-exists=.env --conditions=react-server scripts/maintenance.ts",
    "backup:fetch": "tsx --env-file-if-exists=.env scripts/backup-fetch.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "nodemailer": "10.1.4",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "smtp-server": "3.19.23",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch@10": "11.0.1",
    "smtp-server": {
      "nodemailer": "$nodemailer"
    }
  }
}
